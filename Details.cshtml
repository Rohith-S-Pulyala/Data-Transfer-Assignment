@model Country 

@*Tells the view it is receiving a single country object.*@

@*Details of country to add to Favorites*@
<div class="container mt-5">
    <div class="row">
        <div class="col-md-6">
            <img src="https://flagpedia.net/data/flags/w580/@(Model.FlagCode).png" class="img-fluid shadow" alt="@Model.Name" />
        </div>
        <div class="col-md-6">
            <h1>@Model.Name</h1>
            <p><strong>Game:</strong> @Model.Game</p>
            <p><strong>Category:</strong> @Model.Category</p>
            <p><strong>Game:</strong> @Model.Sport</p>

            @*Buttons available for use in adding to your favorites page and returning to home.*@
            <div class="mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Return to Home Page</a>

                <form asp-controller="Favorites" asp-action="Add" method="post" style="display:inline;">
                    <input type="hidden" name="id" value="@Model.Name" />
                    <button type="submit" class="btn btn-primary">Add to Favorites</button>
                </form>
            </div>
        </div>
    </div>
</div>
